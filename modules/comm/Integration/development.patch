+/* Main nhận các sự kiện mạng, bảng tên và yêu cầu OTA; Comm không gọi API thiết bị. */
+static void prvPollComm(void)
+{
+    Comm_Event event;
+    TickType_t now = xTaskGetTickCount();
+    BaseType_t paused, closed;
+    while (xTaskCommGetEvent(&event, 0) == pdPASS) {
+        if (event.type == COMM_EVT_OTA_PREPARE) {
+            if (xOtaActive || prvIsMenuState() || eState == CTRL_STATE_LOCKED ||
