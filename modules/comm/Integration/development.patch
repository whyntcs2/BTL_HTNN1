+            ulOtaServoBefore = ulTaskServoCloseGeneration();
+            ulOtaFingerBefore = ulTaskAS608PauseGeneration();
+            xOtaActive = pdTRUE; xOtaReadySent = pdFALSE; xOtaCloseSeen = pdFALSE;
+            paused = xTaskAS608SendCommand(AS608_CMD_PAUSE, 0, 0);
+            closed = xTaskServoSendCommand(SERVO_CMD_CLOSE, 0, 0);
+            xOtaAbortPending = paused != pdPASS || closed != pdPASS;
+            if (xOtaAbortPending) { xTaskCommOtaRespond(usOtaSequence, pdFALSE); }
+            prvLine(2, "CHUAN BI CAP NHAT"); prvLine(3, "DONG CUA, DUNG VAN TAY");
+        } else if (event.type == COMM_EVT_OTA_ABORT && xOtaActive && event.sequence == usOtaSequence) {
+            xOtaAbortPending = pdTRUE;
+        } else if (!xOtaActive && eState == CTRL_STATE_SCAN && !xRedrawPending) {
+            if (event.type == COMM_EVT_LINK && !event.link) { prvLine(7, "MAT LIEN KET ESP32"); }
+            if (event.type == COMM_EVT_STATUS) {
+                prvLine(7, !event.wifi ? "WIFI OFF: LUU LOG" : event.cloud ? "WIFI/SHEETS OK" : "WIFI OK: CHO SHEETS");
+            }
+        }
+    }
+    if (!xOtaActive) { return; }
+    if (!xOtaReadySent && (TickType_t)(now - xOtaSince) >= pdMS_TO_TICKS(10000UL)) {
+        xTaskCommOtaRespond(usOtaSequence, pdFALSE); xOtaAbortPending = pdTRUE;
+    }
+    if (xOtaAbortPending) {
+        /* Queue cảm biến có thể đang đầy: thử lại ở vòng sau, không chặn Main vô hạn. */
+        if (xTaskAS608SendCommand(AS608_CMD_RESUME, 0, 0) == pdPASS) {
+            xOtaActive = pdFALSE; xOtaAbortPending = pdFALSE;
+            eState = CTRL_STATE_SCAN; ucFingerFail = 0; ucPinLen = 0; xRedrawPending = pdFALSE;
+            prvShowState();
+        }
+        return;
+    }
+    if (ulTaskServoCloseGeneration() != ulOtaServoBefore && !xOtaCloseSeen) {
+        xOtaCloseSeen = pdTRUE; xOtaClosedSince = now;
+    }
+    if (!xOtaReadySent && xOtaCloseSeen && ulTaskAS608PauseGeneration() != ulOtaFingerBefore &&
+        (TickType_t)(now - xOtaClosedSince) >= pdMS_TO_TICKS(1000UL) && uxTaskCommPendingLogs() == 0) {
+        if (xTaskCommOtaRespond(usOtaSequence, pdTRUE) == pdPASS) {
+            xOtaReadySent = pdTRUE; prvLine(2, "DANG NAP FIRMWARE");
+            prvLine(3, "KHONG NGAT NGUON");
+        }
+    }
+}
